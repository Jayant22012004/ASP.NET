<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="MasterPageDemo.SiteMaster" %>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <title>Master Page Demo</title>
    <style type="text/css">
        body { font-family: Segoe UI, Arial, sans-serif; margin: 0; }
        header { background: #34495e; color: #fff; padding: 18px 30px; }
        header h1 { margin: 0; font-size: 22px; }
        nav { background: #2c3e50; padding: 10px 30px; }
        nav a { color: #ecf0f1; margin-right: 18px; text-decoration: none; }
        nav a:hover { text-decoration: underline; }
        .content-area { padding: 25px 30px; min-height: 250px; }
        footer { background: #ecf0f1; padding: 12px 30px; color: #7f8c8d; font-size: 13px; }
    </style>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <header>
            <h1>My Web Application &ndash; Master Page Demo</h1>
        </header>
        <nav>
            <a href="Default.aspx">Home</a>
            <a href="Default.aspx">About</a>
        </nav>
        <div class="content-area">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>
        <footer>
            &copy; <%= DateTime.Now.Year %> My Web Application &ndash; common header/footer defined ONCE in Site.master
        </footer>
    </form>
</body>
</html>
